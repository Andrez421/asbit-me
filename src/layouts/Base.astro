---
import '../styles/tailwind.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL('/', Astro.site ?? 'https://asbit.me');
const socialImage = new URL('/og-card.png', canonical);
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrés Sebastián Bravo Palacios',
  url: canonical.href,
  image: socialImage.href,
  jobTitle: 'Systems Analyst and Full Stack Developer',
  address: { '@type': 'PostalAddress', addressLocality: 'Popayán', addressCountry: 'CO' },
  sameAs: ['https://github.com/Andrez421'],
  knowsAbout: ['Full Stack Development', 'DevOps', 'Infrastructure', 'Automation', 'Artificial Intelligence'],
});
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Andrés Sebastián Bravo" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Andrés Sebastián Bravo — Full Stack, DevOps e infraestructura" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="Andrés Sebastián Bravo — Full Stack, DevOps e infraestructura" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ECEDEF" />
    <link rel="canonical" href={canonical.href} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={structuredData} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230B0C0E'/%3E%3Cpath d='M9 8v16h4v-6h4.5c3 0 5-1.8 5-5s-2-5-5-5zm4 3.5h3.8c1.2 0 1.7.6 1.7 1.5s-.5 1.5-1.7 1.5H13z' fill='%23ECEDEF'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,100..1000&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="nojs">
    <slot />
    <script>
      import '../scripts/portfolio.ts';
    </script>
  </body>
</html>
