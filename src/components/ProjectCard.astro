---
import type { Project } from '../data/projects';
import { es } from '../lib/render';
import { diagram } from '../lib/diagram';

interface Props {
  project: Project;
  open: boolean;
}
const { project: p, open } = Astro.props;
const nameKey = typeof p.name === 'string' ? undefined : `p.${p.id}.n`;
const kind = p.k === 'pro' ? 'Profesional' : 'Personal';
---

<li class={`prow${open ? ' open' : ''}`} data-id={p.id}><button class="phead" type="button" aria-expanded={open} aria-controls={`b-${p.id}`}><span class="pname" data-i18n={nameKey}>{es(p.name)}</span><span class="pkind" data-i18n={`p.${p.id}.k`}>{kind}</span><span class="plus" aria-hidden="true"></span></button><div class="pbody" id={`b-${p.id}`} inert={!open}><div class="pin"><div class="pcont grid grid-cols-[minmax(0,.85fr)_minmax(0,1.35fr)] gap-12 pt-[.4rem] pb-[2.6rem] max-mq1000:grid-cols-1 max-mq1000:gap-[1.6rem]"><div><p data-i18n={`p.${p.id}.d`}>{p.d.es}</p><p class="stk">{p.stk}</p></div><Fragment set:html={diagram(p.cols, p.id)} /></div></div></div></li>
