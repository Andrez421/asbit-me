---
import { kinetic } from '../lib/render';
---

<section id="contact" class="inv">
  <div class="in">
    <p class="lead rv" data-i18n="c.lead">¿Hay un sistema que construir o poner en pie?</p>
    <a class="mail" id="mail" href="mailto:asbravopa@gmail.com" aria-label="asbravopa@gmail.com" data-kin data-w0="600" data-wd0="78" data-w1="900" data-wd1="118" data-sigma="130" set:html={kinetic('asbravopa@gmail.com')}></a>
    <p class="cp" data-i18n="c.p">Respondo por correo. También estoy abierto a colaboraciones y proyectos freelance.</p>
    <div class="ct-row">
      <button id="copy" type="button" data-i18n="c.copy">Copiar correo</button>
      <a href="https://github.com/Andrez421" target="_blank" rel="noopener">GitHub</a>
      <a href="https://asbit.me">asbit.me</a>
    </div>
    <footer><span>© <span id="yr"></span> Andrés Sebastián Bravo Palacios</span><span>Popayán, <span class="clock" id="clock2"></span> (UTC−5)</span></footer>
  </div>
</section>
